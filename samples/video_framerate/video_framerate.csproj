<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))'">true</IsWindows>
    <IsMacOS Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))'">true</IsMacOS>
    <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">true</IsLinux>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x64;arm64</Platforms>
  </PropertyGroup>

  <!-- Native architecture follows the build platform: native architecture (x64 or arm64) by default, or the explicit Platform. Output goes to bin/<arch>/<tfm> -->
  <PropertyGroup>
    <AVB_ARCH>x64</AVB_ARCH>
    <AVB_ARCH Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' ">arm64</AVB_ARCH>
    <AVB_ARCH Condition=" '$(Platform)' == 'x64' ">x64</AVB_ARCH>
    <AVB_ARCH Condition=" '$(Platform)' == 'arm64' ">arm64</AVB_ARCH>
    <OutputPath>../../bin/$(AVB_ARCH)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsLinux)'=='true' or '$(IsMacOS)'=='true'">
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsWindows)'=='true'">
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="AVBlocks.clrcore.$(AVB_ARCH)">
      <HintPath>../../bin/$(AVB_ARCH)/$(TargetFramework)/AVBlocks.clrcore.$(AVB_ARCH).dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="AVBlocks.clr4.$(AVB_ARCH).dll">
      <HintPath>../../bin/$(AVB_ARCH)/$(TargetFramework)/AVBlocks.clr4.$(AVB_ARCH).dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>
</Project>
